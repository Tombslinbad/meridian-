# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BACHS_API_KEY: Sandbox or Live Secret Key from bachs.io
# Used for server-side processing of checkout sessions and transaction verifications.
BACHS_API_KEY=

# VITE_GOOGLE_MEET_URL: Optional permanent Google Meet room URL for the Bilateral Trade Desk.
# (e.g. https://meet.google.com/xxx-yyyy-zzz). If unset, defaults to live instant room or Google Calendar provisioned link.
VITE_GOOGLE_MEET_URL=

# RESEND_API_KEY: Optional API key from resend.com for 100% automated server-side email delivery.
# If provided, the server automatically delivers HTML confirmation emails without any client sign-in.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Meridian China Advisory <onboarding@resend.dev>"

# GMAIL_APP_PASSWORD: Optional 16-character Google App Password for direct SMTP email delivery via Gmail.
# Alternative to Resend if sending via your personal or business Gmail address.
SMTP_USER="igwev2956@gmail.com"
GMAIL_APP_PASSWORD=

# ADVISOR_GOOGLE_CALENDAR_ICAL_URL: Google Calendar Secret Address in iCal format (.ics)
# (from Google Calendar > Settings > Settings for "igwev2956@gmail.com" > Integrate calendar > Secret address in iCal format)
# Used by the server to sync personal calendar availability and prevent client double-booking.
ADVISOR_GOOGLE_CALENDAR_ICAL_URL=

# Analytics & Ad Tracking Pixels (Optional)
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID="DAPHHSRC77U28JP3A930"

# TIKTOK_EVENTS_API_ACCESS_TOKEN: TikTok Events API Server-Side Access Token (Confidential)
# Generated in TikTok Ads Manager > Assets > Events > Web Events > Select Pixel > Settings > Events API > Generate Access Token
# Used exclusively server-side to report verified CompletePayment conversions and deduplicate with the browser pixel.
# SECURITY: Never expose to frontend/client or prefix with VITE_.
TIKTOK_EVENTS_API_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=


